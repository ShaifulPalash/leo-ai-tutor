# =====================================================================
# Leo AI Tutor - environment template
# Copy this file to ".env" and fill in your own values.  NEVER commit .env
# =====================================================================

# ---------- API keys (free tiers) ----------
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here

# ---------- Model names: "provider/model-id" (LiteLLM format) ----------
# Model names change often. Run `python scripts/check_setup.py` to verify them.
# FAST = small/cheap model (Coordinator routing, Evaluator feedback)
# SMART = higher-quality model (Explainer, Quiz Master)
FAST_MODEL_PRIMARY=groq/openai/gpt-oss-20b
FAST_MODEL_FALLBACK=gemini/gemini-3.5-flash-lite
SMART_MODEL_PRIMARY=groq/openai/gpt-oss-120b
SMART_MODEL_FALLBACK=gemini/gemini-3.8-flash

# ---------- Optional local fallback (needs Ollama installed) ----------
OLLAMA_ENABLED=false
OLLAMA_MODEL=ollama/llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# ---------- Token and rate controls ----------
MAX_TOKENS_ROUTER=400
MAX_TOKENS_EXPLAINER=900
MAX_TOKENS_QUIZ=1200
MAX_TOKENS_EVALUATOR=700
MAX_RPM=20
LLM_TIMEOUT_SECONDS=45
MAX_RETRIES=3
TEMPERATURE=0.3

# ---------- Learning-loop behaviour ----------
SCORE_THRESHOLD=0.6
MAX_RELEARN_ROUNDS=2

# ---------- Optional tools ----------
ENABLE_CALCULATOR=true
ENABLE_WEB_SEARCH=false

# ---------- Logging and debugging ----------
LOG_LEVEL=INFO
DEBUG_MODE=false
LOG_DIR=logs
TRACE_DIR=logs/traces

# ---------- Storage ----------
MEMORY_DB_PATH=data/leo_memory.db